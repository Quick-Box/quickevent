<?xml version="1.0" encoding="UTF-8"?>
<Report width="${options.pageWidth|nonzero|default:210}" height="${options.pageHeight|nonzero|default:297}"
		hinset="${options.horizontalMargin|nonzero|default:10}" vinset="${options.verticalMargin|nonzero|default:5}"
		textStyle="default">
	<Parameter name="reportTitle" default="${'Start list for starters'|tr}"/>
	<styleSheet><include src="../../../shared/qml/reports/ReportStyleCommon.qrepi"/></styleSheet>
	<Frame width="%" height="%" layout="LayoutStacked">
		<include src="../../../shared/qml/reports/QuickEventHeaderFooter.qrepi"/>
		<Frame width="%" height="%" columns="${options.columns}" vinset="10">
			<Band width="%" height="%">
				<include src="../../../shared/qml/reports/QuickEventReportHeader.qrepi"/>
				<Detail width="%" layout="LayoutVertical">
					<Frame width="%" layout="LayoutHorizontal" fill="khaki">
						<Para hinset="1" width="10" textStyle="bold">{{startTimeMin|changed}}</Para>
						<Para hinset="1" width="%" textStyle="bold">{{startTimeText|changed}}</Para>
					</Frame>
					<Frame width="%" layout="LayoutHorizontal">
						<Para width="10">{{classes.name}}</Para>
						<Para visible="${options.isStartListPrintStartNumbers}" width="8" halign="AlignRight">{{competitors.startNumber|positive}}</Para>
						<Para hinset="1" width="%">{{competitorName}}</Para>
						<Para width="16">{{competitors.registration}}</Para>
						<Para width="15" halign="AlignRight">{{runs.siId}}</Para>
						<Para width="12" halign="AlignRight">{{startTimeMs|ogTimeSec}}</Para>
					</Frame>
					<Frame visible="${options.startersOptionsLineSpacing|positive|if:true:false}" height="${options.startersOptionsLineSpacing|positive|default:0}"/>
				</Detail>
			</Band>
		</Frame>
	</Frame>
</Report>
