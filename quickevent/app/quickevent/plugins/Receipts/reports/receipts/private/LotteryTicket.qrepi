<?xml version="1.0" encoding="UTF-8"?>
<Frame hinset="1" vinset="1">
	<Frame width="%" layout="LayoutHorizontal" borderBottom="black2" htmlExportAttributes='{"lpt_textStyle": "bold,underline2"}'>
		<Para width="%" textHAlign="AlignHCenter" textStyle="bold" htmlExportAttributes='{"lpt_textStyle": "bold", "lpt_textWidth": "%", "lpt_textAlign": "center"}'>Slosovatelný kupón</Para>
	</Frame>
	<Frame width="%" layout="LayoutHorizontal" textStyle="bold" borderBottom="black2" htmlExportAttributes='{"lpt_textStyle": "bold,underline2"}'>
		<Para width="%">{{classes.name}} {{competitorName}}</Para>
		<Para textHAlign="AlignRight" htmlExportAttributes='{"lpt_textWidth": "%", "lpt_textAlign": "right"}'>{{competitors.registration|default:NO_REG}}</Para>
	</Frame>
	<Para/>
	<Para/>
	<Frame layout="LayoutHorizontal" valign="AlignVCenter">
		<Frame width="%" borderBottom="black1dot" htmlExportAttributes='{"lpt_textStyle": "underline2"}'/>
		<Para htmlExportAttributes='{"lpt_textWidth": "%", "lpt_textAlign": "center"}'>zde odstřihnout</Para>
		<Frame width="%" borderBottom="black1dot"/>
	</Frame>
	<Para/>
	<Para/>
	<Frame width="%" vinset="1" halign="AlignHCenter" htmlExportAttributes='{"lpt_textWidth": "%", "lpt_textAlign": "center"}'>
		<Para textStyle="bold" htmlExportAttributes='{"lpt_textStyle": "bold"}'>www.VJSPORT.cz</Para>
		<Frame height="2"/>
		<Para textStyle="bold" htmlExportAttributes='{"lpt_textStyle": "bold"}'>podkolenky zdarma</Para>
		<Para halign="AlignHCenter" textHAlign="AlignHCenter">jediné opravdové boty na OB s extrémní výdrží.</Para>
		<Para halign="AlignHCenter" textHAlign="AlignHCenter">Nyní ve stánku HSH podkolenky zdarma ke všem modelům kromě výprodeje.</Para>
		<Para halign="AlignHCenter">www.orienteering.cz</Para>
		<Para textStyle="bold" htmlExportAttributes='{"lpt_textStyle": "bold"}'>Výsledky online</Para>
		<Para halign="AlignHCenter">oresults.eu/events/350</Para>
	</Frame>
</Frame>
