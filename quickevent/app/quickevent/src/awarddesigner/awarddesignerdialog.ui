<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AwardDesignerDialog</class>
 <widget class="QDialog" name="AwardDesignerDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1100</width><height>820</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>800</width><height>600</height></size>
  </property>
  <property name="windowTitle">
   <string>Designer diplomů</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">

   <!-- Top toolbar -->
   <item>
    <layout class="QHBoxLayout" name="topBarLayout">
     <item>
      <widget class="QLabel">
       <property name="text"><string>Název návrhu:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="edDesignName">
