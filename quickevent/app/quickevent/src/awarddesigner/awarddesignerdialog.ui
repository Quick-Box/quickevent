               </item>
               <item>
                <widget class="QCheckBox" name="chkItalic">
                 <property name="text"><string>Kurzíva</string></property>
                </widget>
               </item>
              </layout>
             </item>
             <item row="3" column="0">
              <widget class="QLabel"><property name="text"><string>Barva:</string></property></widget>
             </item>
             <item row="3" column="1">
              <widget class="QPushButton" name="btnColor">
               <property name="text"><string>■ Zvolit barvu</string></property>
              </widget>
             </item>
             <item row="4" column="0">
              <widget class="QLabel"><property name="text"><string>Zarovnání:</string></property></widget>
             </item>
             <item row="4" column="1">
              <widget class="QComboBox" name="cbxAlign"/>
             </item>
            </layout>
           </widget>
          </item>

          <!-- Delete -->
          <item>
           <widget class="QPushButton" name="btnDelete">
            <property name="text"><string>Smazat položku</string></property>
           </widget>
          </item>

