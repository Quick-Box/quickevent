             <item row="1" column="0">
              <widget class="QLabel" name="lblCustomText">
               <property name="text"><string>Text:</string></property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QLineEdit" name="edCustomText">
               <property name="placeholderText"><string>Vlastní text</string></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- Image content (visible for Image items) -->
          <item>
           <widget class="QFrame" name="frameImageContent">
            <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel"><property name="text"><string>Soubor:</string></property></widget>
             </item>
             <item row="0" column="1">
              <layout class="QHBoxLayout">
               <item>
                <widget class="QLineEdit" name="edImagePath">
                 <property name="readOnly"><bool>true</bool></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnBrowseImage">
                 <property name="text"><string>...</string></property>
                 <property name="maximumWidth"><number>28</number></property>
                </widget>
               </item>
              </layout>
             </item>
             <item row="1" column="0" colspan="2">
              <widget class="QCheckBox" name="chkScaleProportional">
               <property name="text"><string>Zachovat poměr stran</string></property>
               <property name="checked"><bool>true</bool></property>
               <property name="toolTip"><string>Při změně velikosti zachovat poměr stran obrázku</string></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- Separator -->
          <item>
           <widget class="QFrame">
            <property name="frameShape"><enum>QFrame::HLine</enum></property>
           </widget>
          </item>

          <!-- Position / size -->
          <item>
           <widget class="QFrame" name="framePosition">
            <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel"><property name="text"><string>X (mm):</string></property></widget>
             </item>
             <item row="0" column="1">
              <widget class="QDoubleSpinBox" name="spX">
               <property name="maximum"><double>500.0</double></property>
               <property name="singleStep"><double>1.0</double></property>
               <property name="decimals"><number>1</number></property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel"><property name="text"><string>Y (mm):</string></property></widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="spY">
               <property name="maximum"><double>500.0</double></property>
               <property name="singleStep"><double>1.0</double></property>
               <property name="decimals"><number>1</number></property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel"><property name="text"><string>Šířka (mm):</string></property></widget>
             </item>
             <item row="2" column="1">
              <widget class="QDoubleSpinBox" name="spW">
               <property name="minimum"><double>5.0</double></property>
               <property name="maximum"><double>500.0</double></property>
               <property name="singleStep"><double>1.0</double></property>
               <property name="decimals"><number>1</number></property>
               <property name="value"><double>50.0</double></property>
              </widget>
             </item>
             <item row="3" column="0">
              <widget class="QLabel"><property name="text"><string>Výška (mm):</string></property></widget>
             </item>
             <item row="3" column="1">
              <widget class="QDoubleSpinBox" name="spH">
               <property name="minimum"><double>3.0</double></property>
               <property name="maximum"><double>500.0</double></property>
               <property name="singleStep"><double>1.0</double></property>
               <property name="decimals"><number>1</number></property>
               <property name="value"><double>15.0</double></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- Text style (visible for Field items only) -->
          <item>
           <widget class="QFrame" name="frameTextStyle">
            <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel"><property name="text"><string>Písmo:</string></property></widget>
             </item>
             <item row="0" column="1">
              <widget class="QFontComboBox" name="cbxFont"/>
