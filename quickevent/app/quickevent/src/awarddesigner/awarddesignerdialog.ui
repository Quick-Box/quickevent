             <item row="1" column="0">
              <widget class="QLabel"><property name="text"><string>Velikost (pt):</string></property></widget>
             </item>
             <item row="1" column="1">
              <widget class="QSpinBox" name="spFontSize">
               <property name="minimum"><number>4</number></property>
               <property name="maximum"><number>200</number></property>
               <property name="value"><number>14</number></property>
