      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnNew">
       <property name="text"><string>Nový</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnLoad">
       <property name="text"><string>Načíst...</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnSave">
       <property name="text"><string>Uložit</string></property>
      </widget>
     </item>
     <item>
      <spacer>
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btnZoomIn">
       <property name="text"><string>+</string></property>
       <property name="maximumWidth"><number>28</number></property>
       <property name="toolTip"><string>Přiblížit (Ctrl+kolečko)</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnZoomOut">
       <property name="text"><string>−</string></property>
       <property name="maximumWidth"><number>28</number></property>
       <property name="toolTip"><string>Oddálit (Ctrl+kolečko)</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnFitView">
       <property name="text"><string>Přizpůsobit</string></property>
       <property name="toolTip"><string>Přizpůsobit pohled ploše</string></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Canvas + properties splitter -->
   <item>
    <widget class="QSplitter" name="splitter">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>

     <!-- Canvas -->
     <widget class="QGraphicsView" name="graphicsView">
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
        <horstretch>3</horstretch><verstretch>0</verstretch>
       </sizepolicy>
      </property>
     </widget>

     <!-- Properties panel -->
     <widget class="QWidget" name="propsPanel">
      <property name="minimumWidth"><number>260</number></property>
      <layout class="QVBoxLayout" name="propsPanelLayout">
       <property name="margin"><number>4</number></property>

       <!-- Add item group -->
       <item>
        <widget class="QGroupBox" name="grpAddItem">
         <property name="title"><string>Přidat položku</string></property>
         <layout class="QHBoxLayout">
          <item>
           <widget class="QPushButton" name="btnAddField">
            <property name="text"><string>+ Textové pole</string></property>
            <property name="toolTip"><string>Přidat datové textové pole</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnAddImage">
            <property name="text"><string>+ Obrázek</string></property>
            <property name="toolTip"><string>Přidat obrázek (PNG, JPG, SVG)</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- Properties group -->
       <item>
        <widget class="QGroupBox" name="grpProperties">
         <property name="title"><string>Vlastnosti vybrané položky</string></property>
         <property name="enabled"><bool>false</bool></property>
         <layout class="QVBoxLayout">
          <property name="spacing"><number>4</number></property>

          <!-- Field content (visible for Field items) -->
          <item>
           <widget class="QFrame" name="frameFieldContent">
            <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
            <layout class="QFormLayout">
             <item row="0" column="0">
              <widget class="QLabel"><property name="text"><string>Pole:</string></property></widget>
             </item>
             <item row="0" column="1">
              <widget class="QComboBox" name="cbxItemField"/>
